@model Reflect.ProviderDashboard.Web.Models.ViewModels.Account.LoginViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Doctor sign in";
}

<main class="login-page">
    <section class="login-story" aria-label="Reflect XR provider dashboard">
        <a class="login-brand" href="/">
            <img src="~/brand/logos/logo-horizontal-full-color.svg" alt="Reflect XR" />
        </a>
        <div class="login-story-copy">
            <p class="eyebrow">Provider workspace</p>
            <h1>A clearer next step.</h1>
            <p>See what changed between sessions. Start a more informed conversation.</p>
        </div>
        <p class="login-story-footnote">Reflect Provider Dashboard · Prototype</p>
    </section>

    <section class="login-panel" aria-labelledby="login-heading">
        <div class="login-form-wrap">
            <p class="eyebrow">Welcome back</p>
            <h2 id="login-heading" class="page-title">Doctor sign in</h2>
            <p class="text-muted login-intro">Use the demo credentials supplied by the presenter. All patient records are fictional.</p>

            <div class="login-demo-note" role="note">
                <strong>Prototype access</strong>
                <span>This local account system is for fictional data.</span>
            </div>

            <form asp-controller="Account" asp-action="Login" method="post" class="login-form">
                <input asp-for="ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="login-validation" role="alert"></div>

                <div class="login-field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" autocomplete="username" inputmode="email" autofocus />
                    <span asp-validation-for="Email" class="login-field-error"></span>
                </div>

                <div class="login-field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="login-field-error"></span>
                </div>

                <label class="login-remember">
                    <input asp-for="RememberMe" />
                    <span>Keep me signed in on this device</span>
                </label>

                <button type="submit" class="btn btn-primary login-submit">Sign in</button>
            </form>

            <p class="login-security-note">Forgot your password? Contact your system administrator. This prototype does not send account recovery email.</p>
            @if (HostEnvironment.IsDevelopment())
            {
            <p class="login-account-link">New to the provider dashboard? <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a></p>
            }
        </div>
    </section>
</main>
