@model Reflect.ProviderDashboard.Web.Models.ViewModels.Account.AcceptInviteViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Accept invitation";
}

<main class="login-page">
    <section class="login-story" aria-label="Reflect XR provider dashboard">
        <a class="login-brand" href="/">
            <img src="~/brand/logos/logo-horizontal-full-color.svg" alt="Reflect XR" />
        </a>
        <div class="login-story-copy">
            <p class="eyebrow">Provider workspace</p>
            <h1>You have been invited to join your care team.</h1>
            <p>Set a password to create your account. Your administrator will assign your caseload.</p>
        </div>
        <p class="login-story-footnote">Reflect Provider Dashboard · Prototype</p>
    </section>

    <section class="login-panel" aria-labelledby="invite-heading">
        <div class="login-form-wrap">
            <p class="eyebrow">Invitation</p>
            <h2 id="invite-heading" class="page-title">Create your account</h2>
            <p class="text-muted login-intro">Signing up as <strong>@Model.Email</strong>.</p>

            <form asp-controller="Account" asp-action="AcceptInvite" method="post" class="login-form">
                <input asp-for="Token" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="login-validation" role="alert"></div>

                <div class="login-field">
                    <label asp-for="DisplayName"></label>
                    <input asp-for="DisplayName" autocomplete="name" autofocus />
                    <span asp-validation-for="DisplayName" class="login-field-error"></span>
                </div>

                <div class="login-field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" autocomplete="new-password" aria-describedby="password-help" />
                    <span id="password-help" class="text-muted fs-13">12+ characters with upper and lowercase letters, a number, and a symbol.</span>
                    <span asp-validation-for="Password" class="login-field-error"></span>
                </div>

                <div class="login-field">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="login-field-error"></span>
                </div>

                <button type="submit" class="btn btn-primary login-submit">Create account</button>
            </form>
            <p class="login-security-note">Invitations are single-use and expire after 72 hours.</p>
        </div>
    </section>
</main>
