@{
    var title = ViewData["Title"] as string ?? "Provider Dashboard";
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? "Provider";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Dashboard";
    var prefTheme = User.FindFirst("pref.theme")?.Value ?? "";
    var prefText = User.FindFirst("pref.textsize")?.Value ?? "";
    var prefTour = User.FindFirst("pref.showtour")?.Value == "1";
    var isAdmin = User.IsInRole(ProviderAuthorization.AdminRole);
}
<!DOCTYPE html>
<html lang="en" data-theme-mode="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title · Reflect XR Provider</title>
    <link rel="icon" type="image/png" href="~/brand/icons/favicon.png" />
    <script nonce="@Context.GetCspNonce()">
        try {
            const savedTheme = localStorage.getItem('reflect-provider-theme');
            if (savedTheme === 'light' || savedTheme === 'dark') {
                document.documentElement.setAttribute('data-theme-mode', savedTheme);
            }
        } catch { }
    </script>
    @if (prefTheme.Length > 0 || prefText.Length > 0 || prefTour)
    {
        <script nonce="@Context.GetCspNonce()">
            // Account preferences are applied once per change, so a later local toggle still sticks.
            try {
                var version = '@prefTheme|@prefText|@(prefTour ? "t" : "")';
                if (localStorage.getItem('reflect-provider-pref-version') !== version) {
                    localStorage.setItem('reflect-provider-pref-version', version);
                    if ('@prefTheme' === 'light' || '@prefTheme' === 'dark') {
                        localStorage.setItem('reflect-provider-theme', '@prefTheme');
                        document.documentElement.setAttribute('data-theme-mode', '@prefTheme');
                    }
                    if (['100%', '112.5%', '125%'].indexOf('@prefText') >= 0) {
                        var stored = JSON.parse(localStorage.getItem('reflect-provider-accessibility') || '{}');
                        stored.textSize = '@prefText';
                        localStorage.setItem('reflect-provider-accessibility', JSON.stringify(stored));
                    }
                    if (@(prefTour ? "true" : "false")) localStorage.removeItem('reflect-provider-tour-seen');
                }
            } catch { }
        </script>
    }
    <link rel="stylesheet" href="~/standins/css/reflect-theme.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/standins/css/provider-workspace.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main-content">Skip to main content</a>
<div id="loadingOverlay" role="status" aria-live="polite"></div>
<div class="offcanvas-backdrop" id="a11yBackdrop"></div>
<div class="sidebar-backdrop" id="sidebarBackdrop"></div>
<aside class="offcanvas-panel" id="a11yPanel" role="dialog" aria-modal="true" aria-hidden="true" inert aria-label="Accessibility settings">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <strong>Accessibility</strong>
        <button type="button" class="btn btn-outline-secondary" id="a11yPanelClose">Close</button>
    </div>
    <label class="fs-13 text-muted" for="panelThemeSelect">Theme</label>
    <select id="panelThemeSelect" class="btn w-100 mb-3">
        <option value="light">Light</option>
        <option value="dark">Dark</option>
    </select>
    <label class="fs-13 text-muted" for="textSizeSelect">Text size</label>
    <select id="textSizeSelect" class="btn w-100 mb-3">
        <option value="100%">Default</option>
        <option value="112.5%">Large</option>
        <option value="125%">Extra large</option>
    </select>
    <label class="fs-13">
        <input type="checkbox" id="colorBlindToggle" />
        Color-blind friendly mode
    </label>
</aside>

<div class="app-shell" id="appShell">
    <nav class="sidebar" id="providerSidebar" aria-label="Provider navigation">
        <a class="sidebar-brand" href="@Url.Action("Dashboard", "Home", new { area = "Provider" })">
            <img src="~/brand/logos/logo-mark-soft-coral.svg" alt="Reflect XR" />
            <span class="sidebar-brand-copy">
                <span class="sidebar-brand-name">Reflect XR</span>
                <span class="sidebar-brand-sub">Provider</span>
            </span>
        </a>
        <div class="category">Overview</div>
        <a class="nav-link @(controller == "Home" && action == "Dashboard" ? "active" : "")" data-short="D" aria-label="Dashboard" href="@Url.Action("Dashboard", "Home", new { area = "Provider" })">
            <span class="nav-link-label">Dashboard</span>
        </a>
        <a class="nav-link @(controller == "Home" && action == "Trust" ? "active" : "")" data-short="T" aria-label="Privacy &amp; trust" href="@Url.Action("Trust", "Home", new { area = "Provider" })">
            <span class="nav-link-label">Privacy &amp; trust</span>
        </a>
        <div class="category">Caseload</div>
        <a class="nav-link @(controller == "Patients" ? "active" : "")" data-short="P" aria-label="Patients" href="@Url.Action("Index", "Patients", new { area = "Provider" })">
            <span class="nav-link-label">Patients</span>
        </a>
        <a class="nav-link @(controller == "Reports" ? "active" : "")" data-short="R" aria-label="Reports" href="@Url.Action("Index", "Reports", new { area = "Provider" })">
            <span class="nav-link-label">Reports</span>
        </a>
        <a class="nav-link @(controller == "Messages" ? "active" : "")" data-short="M" aria-label="Messages" href="@Url.Action("Index", "Messages", new { area = "Provider" })">
            <span class="nav-link-label">Messages</span>
        </a>
        <a class="nav-link @(controller == "Devices" ? "active" : "")" data-short="V" aria-label="Devices" href="@Url.Action("Index", "Devices", new { area = "Provider" })">
            <span class="nav-link-label">Devices</span>
        </a>
        <a class="nav-link @(controller == "Home" && action == "Graph" ? "active" : "")" data-short="M" aria-label="Caseload map" href="@Url.Action("Graph", "Home", new { area = "Provider" })">
            <span class="nav-link-label">Caseload map</span>
        </a>
        <a class="nav-link @(controller == "Modules" ? "active" : "")" data-short="R" aria-label="Module reference" href="@Url.Action("Index", "Modules", new { area = "Provider" })">
            <span class="nav-link-label">Module reference</span>
        </a>
        @if (isAdmin)
        {
            <div class="category">Admin</div>
            <a class="nav-link @(controller == "Team" ? "active" : "")" data-short="A" aria-label="Team" href="@Url.Action("Index", "Team", new { area = "Provider" })">
                <span class="nav-link-label">Team</span>
            </a>
        }
        <button type="button" class="btn btn-outline-secondary tour-open" id="tourOpen">Take the tour</button>
        <div class="sidebar-footer">Persistent Technology · 2026</div>
    </nav>
    <div class="main-column">
        <header class="app-header">
            <button type="button" class="btn btn-outline-secondary mobile-menu-toggle" id="mobileMenuToggle" aria-controls="providerSidebar" aria-expanded="false">Menu</button>
            <button type="button" class="btn btn-outline-secondary sidebar-collapse-toggle" id="sidebarCollapseToggle" aria-controls="providerSidebar" aria-expanded="true">Collapse navigation</button>
            <div>
                <div class="header-kicker">Immersive Arts for Wellness</div>
                <div class="fs-13 text-muted">Provider workspace</div>
            </div>
            <details class="account-menu">
                <summary class="btn btn-outline-secondary">Account &amp; display</summary>
                <div class="header-actions">
                <button type="button" class="btn btn-outline-secondary" id="a11yPanelToggle" aria-controls="a11yPanel" aria-expanded="false">Accessibility</button>
                <button type="button" class="btn btn-primary-light" id="themeToggle">Toggle theme</button>
                <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Settings", new { area = "Provider" })">Settings</a>
                <span class="provider-chip">@(User.FindFirst("display_name")?.Value ?? User.Identity?.Name)</span>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                    <button type="submit" class="btn btn-outline-secondary">Sign out</button>
                </form>
                </div>
            </details>
        </header>
        <div class="demo-banner">Synthetic demo · Fictional patient records</div>
        <div class="breadcrumb-bar">
            Provider / @controller / @action
        </div>
        <main class="page-content" id="main-content" tabindex="-1">
            @RenderBody()
        </main>
        <p class="legal-fineprint">Designed around HIPAA privacy and security safeguards (TLS, unique clinician sign-in, assigned-caseload access). Records here are fictional; this demo is not a HIPAA-covered production system.</p>
    </div>
</div>

<partial name="_ChatWidget" />
<dialog id="tourDialog" class="tour-dialog" aria-labelledby="tourTitle">
    <h2 id="tourTitle" class="h4"></h2>
    <p id="tourBody"></p>
    <p class="fs-13 text-muted" id="tourStep"></p>
    <div class="d-flex gap-2 justify-content-end">
        <button type="button" class="btn btn-outline-secondary" id="tourSkip">Skip</button>
        <button type="button" class="btn btn-outline-secondary" id="tourBack">Back</button>
        <button type="button" class="btn btn-primary-light" id="tourNext">Next</button>
    </div>
</dialog>
<script src="~/standins/js/messageService.js"></script>
<script src="~/standins/js/layoutController.js" asp-append-version="true"></script>
<script src="~/js/controllers/provider/chatController.js" asp-append-version="true"></script>
<script src="~/js/controllers/provider/tourController.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
