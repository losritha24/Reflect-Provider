@{
    var title = ViewData["Title"] as string ?? "Provider Dashboard";
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? "Provider";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Dashboard";
}
<!DOCTYPE html>
<html lang="en" data-theme-mode="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title · Reflect XR Provider</title>
    <link rel="icon" type="image/png" href="~/brand/icons/favicon.png" />
    <script nonce="@Context.GetCspNonce()">
        try {
            const savedTheme = localStorage.getItem('reflect-provider-theme');
            if (savedTheme === 'light' || savedTheme === 'dark') {
                document.documentElement.setAttribute('data-theme-mode', savedTheme);
            }
        } catch { }
    </script>
    <link rel="stylesheet" href="~/standins/css/reflect-theme.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/standins/css/provider-workspace.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main-content">Skip to main content</a>
<div id="loadingOverlay" role="status" aria-live="polite"></div>
<div class="offcanvas-backdrop" id="a11yBackdrop"></div>
<div class="sidebar-backdrop" id="sidebarBackdrop"></div>
<aside class="offcanvas-panel" id="a11yPanel" role="dialog" aria-modal="true" aria-hidden="true" inert aria-label="Accessibility settings">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <strong>Accessibility</strong>
        <button type="button" class="btn btn-outline-secondary" id="a11yPanelClose">Close</button>
    </div>
    <label class="fs-13 text-muted" for="panelThemeSelect">Theme</label>
    <select id="panelThemeSelect" class="btn w-100 mb-3">
        <option value="light">Light</option>
        <option value="dark">Dark</option>
    </select>
    <label class="fs-13 text-muted" for="textSizeSelect">Text size</label>
    <select id="textSizeSelect" class="btn w-100 mb-3">
        <option value="100%">Default</option>
        <option value="112.5%">Large</option>
        <option value="125%">Extra large</option>
    </select>
    <label class="fs-13">
        <input type="checkbox" id="colorBlindToggle" />
        Color-blind friendly mode
    </label>
</aside>

<div class="app-shell" id="appShell">
    <nav class="sidebar" id="providerSidebar" aria-label="Provider navigation">
        <a class="sidebar-brand" href="@Url.Action("Dashboard", "Home", new { area = "Provider" })">
            <img src="~/brand/logos/logo-mark-soft-coral.svg" alt="Reflect XR" />
            <span class="sidebar-brand-copy">
                <span class="sidebar-brand-name">Reflect XR</span>
                <span class="sidebar-brand-sub">Provider</span>
            </span>
        </a>
        <div class="category">Overview</div>
        <a class="nav-link @(controller == "Home" ? "active" : "")" data-short="D" aria-label="Dashboard" href="@Url.Action("Dashboard", "Home", new { area = "Provider" })">
            <span class="nav-link-label">Dashboard</span>
        </a>
        <div class="category">Caseload</div>
        <a class="nav-link @(controller == "Patients" ? "active" : "")" data-short="P" aria-label="Patients" href="@Url.Action("Index", "Patients", new { area = "Provider" })">
            <span class="nav-link-label">Patients</span>
        </a>
        <div class="sidebar-footer">Persistent Technology · 2026</div>
    </nav>
    <div class="main-column">
        <header class="app-header">
            <button type="button" class="btn btn-outline-secondary mobile-menu-toggle" id="mobileMenuToggle" aria-controls="providerSidebar" aria-expanded="false">Menu</button>
            <button type="button" class="btn btn-outline-secondary sidebar-collapse-toggle" id="sidebarCollapseToggle" aria-controls="providerSidebar" aria-expanded="true">Collapse navigation</button>
            <div>
                <div class="header-kicker">Immersive Arts for Wellness</div>
                <div class="fs-13 text-muted">Provider workspace</div>
            </div>
            <details class="account-menu">
                <summary class="btn btn-outline-secondary">Account &amp; display</summary>
                <div class="header-actions">
                <button type="button" class="btn btn-outline-secondary" id="a11yPanelToggle" aria-controls="a11yPanel" aria-expanded="false">Accessibility</button>
                <button type="button" class="btn btn-primary-light" id="themeToggle">Toggle theme</button>
                <span class="provider-chip">@(User.FindFirst("display_name")?.Value ?? User.Identity?.Name)</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                    <button type="submit" class="btn btn-outline-secondary">Sign out</button>
                </form>
                </div>
            </details>
        </header>
        <div class="demo-banner">Synthetic demo · Fictional patient records</div>
        <div class="breadcrumb-bar">
            Provider / @controller / @action
        </div>
        <main class="page-content" id="main-content" tabindex="-1">
            @RenderBody()
        </main>
    </div>
</div>

<script src="~/standins/js/messageService.js"></script>
<script src="~/standins/js/layoutController.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
