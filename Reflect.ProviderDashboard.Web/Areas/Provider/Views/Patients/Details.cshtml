@model PatientDetailsViewModel
@{
    ViewData["Title"] = Model.DisplayName;
}
<div class="mb-4">
    <p class="eyebrow">Patient record</p>
    <h1 class="page-title mb-1">@Model.DisplayName</h1>
    <p class="text-muted fs-13 mb-0">@Model.ExternalPatientId · DOB @Model.DateOfBirthDisplay</p>
    <div class="mt-2">
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-search="@Model.Search" asp-route-trend="@Model.Trend" asp-route-page="@Model.Page">Back to patients</a>
        <a class="btn btn-primary-light" asp-controller="Reports" asp-action="Index" asp-route-patientId="@Model.PatientId">Open report</a>
    </div>
</div>

<ul class="nav nav-tabs" id="patientTabs" role="tablist">
    <li role="presentation"><button type="button" class="nav-link @(Model.TimelineSelected ? "" : "active")" data-tab="overview" id="tab-overview" role="tab" aria-selected="@((!Model.TimelineSelected).ToString().ToLowerInvariant())" aria-controls="panel-overview" tabindex="@(Model.TimelineSelected ? -1 : 0)">Overview</button></li>
    <li role="presentation"><button type="button" class="nav-link @(Model.TimelineSelected ? "active" : "")" data-tab="sessions" id="tab-sessions" role="tab" aria-selected="@(Model.TimelineSelected.ToString().ToLowerInvariant())" aria-controls="panel-sessions" tabindex="@(Model.TimelineSelected ? 0 : -1)">Timeline</button></li>
</ul>

<div id="panel-overview" role="tabpanel" aria-labelledby="tab-overview" tabindex="0" hidden="@(Model.TimelineSelected ? "hidden" : null)">
    <div class="stat-grid">
        <div class="card custom-card">
            <div class="card-body">
                <div class="stat-label">Total sessions</div>
                <div class="stat-value">@Model.TotalSessions</div>
            </div>
        </div>
        <div class="card custom-card">
            <div class="card-body">
                <div class="stat-label">Reflect XR (VR)</div>
                <div class="stat-value">@Model.VrSessionCount</div>
            </div>
        </div>
        <div class="card custom-card">
            <div class="card-body">
                <div class="stat-label">Reflect Mobile</div>
                <div class="stat-value">@Model.MobileSessionCount</div>
            </div>
        </div>
        <div class="card custom-card">
            <div class="card-body">
                <div class="stat-label">Total minutes</div>
                <div class="stat-value">@Model.TotalMinutes</div>
            </div>
        </div>
    </div>
    <div class="card custom-card">
        <div class="card-header"><div class="card-title">Clinical notes (synthetic)</div></div>
        <div class="card-body">
            <p class="mb-2">
                <span class="badge bg-@Model.TrendBadgeColor-transparent text-@Model.TrendBadgeColor">@Model.TrendLabel</span> <span class="text-muted fs-13">Synthetic scenario label</span>
            </p>
            <p class="mb-0">@Model.NotesSummary</p>
        </div>
    </div>
    <section class="work-panel" aria-labelledby="trajectory-heading">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Compared with self</p>
                <h2 id="trajectory-heading">Emotional trajectory</h2>
                <p class="text-muted">Session affect markers (1–10) against this patient’s rolling baseline. Not a population norm.</p>
            </div>
            @if (Model.Trajectory.LatestDeviatesFromSelf)
            {
                <span class="badge bg-warning-transparent">Below personal baseline</span>
            }
        </div>
        @if (Model.Trajectory.Points.Count == 0)
        {
            <p class="empty-state">No affect markers recorded yet.</p>
        }
        else
        {
            @Html.Raw(Model.TrajectoryChartSvg)
            <details class="signal-explainer">
                <summary>View data table</summary>
                <table class="table">
                    <caption>Affect markers for @Model.DisplayName</caption>
                    <thead>
                    <tr>
                        <th scope="col">Session (ET)</th>
                        <th scope="col">Affect</th>
                        <th scope="col">Personal baseline</th>
                        <th scope="col">Usual range</th>
                        <th scope="col">Vs self</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var point in Model.Trajectory.Points.Reverse())
                    {
                        <tr>
                            <td>@point.StartedAtUtc.ToUsDateTimeString()</td>
                            <td>@point.Score</td>
                            <td>@(point.RollingBaseline?.ToString("0.0") ?? "Building")</td>
                            <td>@(point.UsualLow is null ? "—" : $"{point.UsualLow:0.0}–{point.UsualHigh:0.0}")</td>
                            <td>@(point.DeviatesBelowSelf ? "Below usual range" : "Within personal range")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </details>
        }
    </section>
    <section class="work-panel" aria-labelledby="programs-heading">
        <div class="section-heading">
            <div>
                <h2 id="programs-heading">Programs used</h2>
                <p class="text-muted">Sessions by Reflect program. Programs not listed have no sessions yet.</p>
            </div>
            <a class="btn btn-outline-secondary" asp-controller="Modules" asp-action="Index">Module reference</a>
        </div>
        @if (Model.ProgramUsage.Count == 0)
        {
            <p class="empty-state">No sessions yet.</p>
        }
        else
        {
            <div class="table-responsive" tabindex="0" role="region" aria-label="Programs used table; scroll horizontally for more columns">
                <table class="table">
                    <caption class="visually-hidden">Sessions by program for @Model.DisplayName</caption>
                <thead><tr><th scope="col">Program</th><th scope="col">Sessions</th><th scope="col">Modules tried</th></tr></thead>
                <tbody>
                @foreach (var program in Model.ProgramUsage)
                {
                    <tr><td>@program.Group</td><td>@program.Sessions</td><td>@string.Join(", ", program.Modules)</td></tr>
                }
                </tbody>
                </table>
            </div>
        }
    </section>
    <section class="work-panel" aria-labelledby="devices-heading">
        <div class="section-heading">
            <div>
                <h2 id="devices-heading">Assigned devices</h2>
                <p class="text-muted">Hardware can be moved to another patient without deleting it or rewriting this record.</p>
            </div>
            <a class="btn btn-outline-secondary" asp-controller="Devices" asp-action="Index">Manage devices</a>
        </div>
        @if (Model.Devices.Count == 0)
        {
            <p class="empty-state">No headset or mobile install is currently assigned here.</p>
        }
        else
        {
            <ul>
            @foreach (var device in Model.Devices)
            {
                <li>@device.DisplayName · @device.HardwareId</li>
            }
            </ul>
        }
    </section>
</div>

<div id="panel-sessions" role="tabpanel" aria-labelledby="tab-sessions" tabindex="0" hidden="@(!Model.TimelineSelected ? "hidden" : null)">
    <form method="get" asp-action="Details" asp-route-id="@Model.PatientId" asp-route-search="@Model.Search" asp-route-trend="@Model.Trend" asp-route-page="@Model.Page" asp-route-tab="timeline" class="filter-toolbar mb-4">
        <input type="hidden" name="search" value="@Model.Search" />
        <input type="hidden" name="trend" value="@Model.Trend" />
        <input type="hidden" name="page" value="@Model.Page" />
        <input type="hidden" name="tab" value="timeline" />
        <div class="filter-field">
            <label for="Platform">Platform</label>
            <select asp-for="Platform">
                <option value="">All platforms</option>
                <option value="Vr">Reflect XR (VR)</option>
                <option value="Mobile">Reflect Mobile</option>
            </select>
        </div>
        <div class="filter-field">
            <label for="Days">Time period</label>
            <select asp-for="Days">
                <option value="">All time</option>
                <option value="7">Last 7 days</option>
                <option value="30">Last 30 days</option>
                <option value="90">Last 90 days</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary-light">Apply filters</button>
        <a asp-action="Details" asp-route-id="@Model.PatientId" asp-route-search="@Model.Search" asp-route-trend="@Model.Trend" asp-route-page="@Model.Page" asp-route-tab="timeline">Clear filters</a>
    </form>
    <section class="work-panel" aria-labelledby="timeline-heading">
        <div class="section-heading"><div><h2 id="timeline-heading">The story between sessions</h2><p class="text-muted">Newest first · @Clock.IanaId · stored UTC · Synthetic session records</p></div><span class="badge bg-info-transparent">Showing @Model.FilteredSessionCount of @Model.TotalSessions sessions</span></div>
        <ol class="patient-timeline">
        @foreach (var session in Model.Sessions)
        {
            <li><time datetime="@session.StartedAtUtc.ToUniversalTime().ToString("O")">@session.SessionDateTimeDisplay</time><article>
                <span class="badge bg-info-transparent">@session.PlatformLabel · @session.DurationMinutes min</span>
                @if (session.AffectScore.HasValue)
                {
                    <span class="badge bg-primary-transparent">Affect @session.AffectScore / 10</span>
                }
                <h3>@session.ModuleName</h3>@if (!string.IsNullOrEmpty(session.ModuleGroup)) { <p class="text-muted fs-13 mb-1">@session.ModuleGroup</p> }<p>@session.ReflectionSummary</p>
                <details><summary>Source details</summary><p class="text-muted">Synthetic demo seed · @session.StartedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'") · No live synchronization</p></details>
            </article></li>
        }
        </ol>
        @if (Model.Sessions.Count == 0) { <p class="empty-state">@(Model.TotalSessions == 0 ? "No sessions yet. Activity will appear here when sessions are available." : "No sessions match these filters. Try a different platform or clear the filters.")</p> }
    </section>
    <details class="work-panel"><summary>View session table</summary>
    <div class="card custom-card">
        <div class="card-header"><div class="card-title">Session history</div></div>
        <div class="card-body table-responsive" tabindex="0" role="region" aria-label="Session history table; scroll horizontally for more columns">
            <table class="table dt-client text-nowrap align-middle">
                <thead>
                <tr>
                    <th scope="col">Date &amp; time (@Clock.Abbreviation)</th>
                    <th scope="col">Duration</th>
                    <th scope="col">Platform</th>
                    <th scope="col">Program</th>
                    <th scope="col">Module</th>
                    <th scope="col">Reflection summary</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var session in Model.Sessions)
                {
                    <tr>
                        <td>@session.SessionDateTimeDisplay</td>
                        <td>@session.DurationMinutes min</td>
                        <td>@session.PlatformLabel</td>
                        <td>@session.ModuleGroup</td>
                        <td>@session.ModuleName</td>
                        <td>@session.ReflectionSummary</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    </details>
</div>

@section Scripts {
    <script nonce="@Context.GetCspNonce()">
        (function () {
            var tabs = document.querySelectorAll('#patientTabs .nav-link');
            var overview = document.getElementById('panel-overview');
            var sessions = document.getElementById('panel-sessions');
            tabs.forEach(function (tab, index) {
                tab.addEventListener('keydown', function (event) {
                    var target;
                    if (event.key === 'ArrowRight') target = (index + 1) % tabs.length;
                    if (event.key === 'ArrowLeft') target = (index + tabs.length - 1) % tabs.length;
                    if (event.key === 'Home') target = 0;
                    if (event.key === 'End') target = tabs.length - 1;
                    if (target !== undefined) { event.preventDefault(); tabs[target].focus(); tabs[target].click(); }
                });
                tab.addEventListener('click', function () {
                    tabs.forEach(function (t) {
                        t.classList.remove('active');
                        t.setAttribute('aria-selected', String(t === tab));
                        t.tabIndex = t === tab ? 0 : -1;
                    });
                    tab.classList.add('active');
                    var name = tab.getAttribute('data-tab');
                    overview.hidden = name !== 'overview';
                    sessions.hidden = name !== 'sessions';
                });
            });
        })();
    </script>
}
