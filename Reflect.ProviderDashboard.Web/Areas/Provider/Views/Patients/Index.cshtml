@model PatientIndexViewModel
@{
    ViewData["Title"] = "Patients";
}
<div class="mb-4">
    <p class="eyebrow">Caseload</p>
    <h1 class="page-title mb-1">Patients</h1>
    <p class="text-muted fs-13 mb-0">Engagement across Reflect XR and Reflect Mobile (synthetic records).</p>
</div>

<form method="get" class="filter-toolbar">
    <div class="filter-field">
    <label for="Search">Search name or patient ID</label>
    <input id="Search" name="search" value="@Model.Search" type="search" />
    </div><div class="filter-field">
    <label for="Trend">Engagement</label>
    <select asp-for="Trend" asp-items="Html.GetEnumSelectList<Reflect.ProviderDashboard.Domain.Enums.EngagementTrend>()">
        <option value="">All engagement signals</option>
    </select>
    </div>
    <button type="submit" class="btn btn-primary-light">Apply filters</button>
    <a asp-action="Index">Clear filters</a>
</form>
<p role="status">@Model.TotalCount patients found. Page @Model.Page of @Model.TotalPages.</p>
<div class="card custom-card">
    <div class="card-header">
        <div class="card-title">Caseload</div>
    </div>
    <div class="card-body table-responsive">
        <table class="table dt-client text-nowrap align-middle">
            <thead>
            <tr>
                <th>Patient</th>
                <th>ID</th>
                <th>Sessions</th>
                <th>Last session</th>
                <th>Primary platform</th>
                <th>Engagement (synthetic scenario)</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr class="row-link" data-navigation-row>
                    <td><a asp-action="Details" asp-route-id="@row.PatientId" data-navigation-link>@row.DisplayName</a></td>
                    <td>@row.ExternalPatientId</td>
                    <td>@row.TotalSessions</td>
                    <td>@row.LastSessionDisplay</td>
                    <td>
                        <span class="badge @(row.PrimaryPlatformLabel.Contains("VR") ? "bg-primary-transparent" : "bg-info-transparent")">@row.PrimaryPlatformLabel</span>
                    </td>
                    <td>
                        <span class="badge bg-@row.TrendBadgeColor-transparent text-@row.TrendBadgeColor">@row.TrendLabel</span>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalCount == 0)
{
    <p>No patients match these filters.</p>
}
<nav aria-label="Patient pages">
    @if (Model.Page > 1)
    {
        <a asp-action="Index" asp-route-search="@Model.Search" asp-route-trend="@Model.Trend" asp-route-page="@(Model.Page - 1)">Previous</a>
    }
    @if (Model.Page < Model.TotalPages)
    {
        <a asp-action="Index" asp-route-search="@Model.Search" asp-route-trend="@Model.Trend" asp-route-page="@(Model.Page + 1)">Next</a>
    }
</nav>
