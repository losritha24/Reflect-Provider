@{ ViewData["Title"] = "Assistant"; }
<section class="work-panel" aria-labelledby="chat-heading">
    <h1 id="chat-heading" class="h3">Assistant <span class="badge">Prototype</span></h1>
    <p class="text-muted fs-13">Not connected to a language model. Don't enter patient names or identifiers: they are removed before processing, and messages are never saved.</p>
    @Html.AntiForgeryToken()
    <div id="chatLog" class="chat-log" role="log" aria-live="polite" aria-label="Conversation"></div>
    <form id="chatForm" class="chat-form" autocomplete="off">
        <label for="chatInput" class="visually-hidden">Your question</label>
        <input id="chatInput" class="form-control" type="text" maxlength="500" placeholder="Ask how to use the dashboard" required />
        <button type="submit" class="btn btn-primary-light">Send</button>
    </form>
</section>
@section Scripts {
    <script src="~/js/controllers/provider/chatController.js" asp-append-version="true"></script>
}
