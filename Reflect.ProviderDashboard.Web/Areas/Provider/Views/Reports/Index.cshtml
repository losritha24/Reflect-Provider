@model Reflect.ProviderDashboard.Web.Models.ViewModels.Provider.Reports.ClinicalReportViewModel
@{
    ViewData["Title"] = "Reports";
}
<div class="report-page-heading">
    <div>
        <p class="eyebrow">Caseload notes</p>
        <h1 class="page-title mb-1">Observation snapshot</h1>
        <p class="text-muted fs-13 mb-0">A period of Reflect XR and Reflect Mobile activity for one person. Print or download after you set the window.</p>
    </div>
    @if (Model.HasCaseload)
    {
        <div class="report-actions no-print">
            <button type="button" class="btn btn-outline-secondary" id="reportPrint">Print</button>
            <a class="btn btn-primary-light" asp-action="Pdf"
               asp-route-patientId="@Model.PatientId"
               asp-route-from="@Model.From.ToString("yyyy-MM-dd")"
               asp-route-to="@Model.To.ToString("yyyy-MM-dd")"
               asp-route-summary="@Model.IncludeSummary.ToString().ToLowerInvariant()"
               asp-route-history="@Model.IncludeHistory.ToString().ToLowerInvariant()"
               asp-route-split="@Model.IncludeSplit.ToString().ToLowerInvariant()"
               asp-route-preview="true">Download PDF</a>
        </div>
    }
</div>

@if (!Model.HasCaseload)
{
    <p class="empty-state">No assigned patients are available for a report.</p>
}
else
{
<div class="report-layout">
    <form method="get" class="work-panel report-settings no-print" aria-labelledby="report-settings-heading">
        <h2 id="report-settings-heading">Who to observe</h2>
        <p class="text-muted">One person, one window. Refresh after you change the range.</p>
        <div class="filter-field">
            <label for="patientId">Patient</label>
            <select id="patientId" name="patientId">
                @foreach (var patient in Model.Patients)
                {
                    <option value="@patient.Id" selected="@(patient.Id == Model.PatientId ? "selected" : null)">@patient.DisplayName (@patient.ExternalPatientId)</option>
                }
            </select>
        </div>
        <div class="report-date-row">
            <div class="filter-field report-date-field">
                <label for="from">Window starts</label>
                <input id="from" name="from" type="date" value="@Model.From.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="filter-field report-date-field">
                <label for="to">Window ends</label>
                <input id="to" name="to" type="date" value="@Model.To.ToString("yyyy-MM-dd")" required />
            </div>
        </div>
        <fieldset class="report-sections">
            <legend>Sections to include</legend>
            <input type="hidden" name="preview" value="true" />
            <label><input type="checkbox" name="summary" value="true" @(Model.IncludeSummary ? "checked" : null) /> Patient summary</label>
            <label><input type="checkbox" name="history" value="true" @(Model.IncludeHistory ? "checked" : null) /> Session history</label>
            <label><input type="checkbox" name="split" value="true" @(Model.IncludeSplit ? "checked" : null) /> Platform split and duration</label>
        </fieldset>
        <button type="submit" class="btn btn-outline-secondary w-100">Refresh preview</button>
    </form>

    <article class="report-sheet" aria-labelledby="report-sheet-heading">
        <header class="report-hero">
            <p class="report-kicker">Reflect XR · Persistent Technology</p>
            <div class="report-hero-top">
                <h2 id="report-sheet-heading">@Model.PatientName</h2>
                <time datetime="@Model.PreparedOn">Prepared @Model.PreparedOn</time>
            </div>
            <p class="report-id">@Model.ExternalPatientId · @Model.ClinicianName</p>
            <p class="report-window">@Model.ReportingPeriod</p>
            <p class="report-module-flag"><span>Main module</span> @Model.MainModule</p>
        </header>

        @if (Model.IncludeSplit)
        {
            <div class="report-ticker" aria-label="Activity in range">
                <div>
                    <span class="stat-value">@Model.SessionCount</span>
                    <span>Sessions</span>
                </div>
                <div>
                    <span class="stat-value">@Model.TotalMinutes</span>
                    <span>Minutes</span>
                </div>
                <div>
                    <span class="stat-value">@Model.XrCount</span>
                    <span>Reflect XR</span>
                </div>
                <div>
                    <span class="stat-value">@Model.MobileCount</span>
                    <span>Reflect Mobile</span>
                </div>
            </div>
        }

        @if (Model.IncludeSummary)
        {
            <section class="report-block" aria-labelledby="report-summary-heading">
                <h3 id="report-summary-heading">What changed in clinic notes</h3>
                <blockquote>@(string.IsNullOrWhiteSpace(Model.NotesSummary) ? "No clinical notes recorded." : Model.NotesSummary)</blockquote>
            </section>
        }

        @if (Model.IncludeHistory)
        {
            <section class="report-block" aria-labelledby="report-history-heading">
                <h3 id="report-history-heading">Sessions in this window</h3>
                @if (Model.Sessions.Count == 0)
                {
                    <p class="empty-state">No sessions in this reporting period.</p>
                }
                else
                {
                    <ol class="report-timeline">
                    @foreach (var session in Model.Sessions)
                    {
                        <li>
                            <time>@session.Date</time>
                            <div>
                                <strong>@session.Module</strong>
                                <p>@session.Platform · @session.DurationMinutes min</p>
                            </div>
                        </li>
                    }
                    </ol>
                }
            </section>
        }

        <p class="report-footnote">Fictional records. This demo is not a HIPAA-covered production system. Times are shown in @Clock.Abbreviation (@Clock.IanaId).</p>
    </article>
</div>
}

@section Scripts {
    <script nonce="@Context.GetCspNonce()">
        document.getElementById('reportPrint')?.addEventListener('click', function () { window.print(); });
    </script>
}
